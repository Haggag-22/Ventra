from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="ec2.amazonaws.com" and aws.cloudtrail.event_name=="RunInstances" and (aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"p2.*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"p3.*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"p4*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"p5*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"g3*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"g4*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"g5*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"g6*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"inf*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"trn*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"x1*" or aws.cloudtrail.flattened.request_parameters like "*\"instanceType\":\"x2*")
