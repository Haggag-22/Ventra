from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="eks.amazonaws.com" and aws.cloudtrail.event_name=="AssociateAccessPolicy" and (aws.cloudtrail.flattened.request_parameters like "*AmazonEKSClusterAdminPolicy*" or aws.cloudtrail.flattened.request_parameters like "*AmazonEKSAdminPolicy*")
