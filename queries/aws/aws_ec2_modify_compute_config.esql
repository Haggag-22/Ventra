from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="ec2.amazonaws.com" and (aws.cloudtrail.event_name in ("ModifyImageAttribute", "ModifyInstanceMetadataOptions", "ModifyLaunchTemplate", "ModifyInstanceAttribute")) and not aws.cloudtrail.flattened.request_parameters like "*\"attribute\":\"userData\"*" or aws.cloudtrail.event_source=="servicequotas.amazonaws.com" and aws.cloudtrail.event_name=="RequestServiceQuotaIncrease"
