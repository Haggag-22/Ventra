from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="ec2.amazonaws.com" and (aws.cloudtrail.event_name in ("DescribeRegions", "DescribeAvailabilityZones", "DescribeAccountAttributes")) or aws.cloudtrail.event_source=="organizations.amazonaws.com" and (aws.cloudtrail.event_name in ("DescribeOrganization", "ListAWSServiceAccessForOrganization")) or aws.cloudtrail.event_source=="servicequotas.amazonaws.com" and aws.cloudtrail.event_name=="ListServiceQuotas"
