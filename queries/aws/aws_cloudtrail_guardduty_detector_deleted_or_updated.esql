from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="guardduty.amazonaws.com" and (aws.cloudtrail.event_name=="DeleteDetector" or aws.cloudtrail.event_name=="UpdateDetector" and aws.cloudtrail.flattened.request_parameters like "*\"enable\":false*") and (aws.cloudtrail.error_code=="Success" or aws.cloudtrail.error_code is null)
