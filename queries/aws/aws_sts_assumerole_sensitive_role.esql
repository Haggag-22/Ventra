from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="sts.amazonaws.com" and aws.cloudtrail.event_name=="AssumeRole" and (aws.cloudtrail.flattened.request_parameters like "*AdministratorAccess*" or aws.cloudtrail.flattened.request_parameters like "*OrganizationAccountAccessRole*" or aws.cloudtrail.flattened.request_parameters like "*PowerUser*" or aws.cloudtrail.flattened.request_parameters like "*/Admin*" or aws.cloudtrail.flattened.request_parameters like "*role/Admin*" or aws.cloudtrail.flattened.request_parameters like "*SecurityAudit*")
