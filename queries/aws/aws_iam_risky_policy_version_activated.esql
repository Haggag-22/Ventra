from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="iam.amazonaws.com" and aws.cloudtrail.event_name=="SetDefaultPolicyVersion" and (aws.cloudtrail.flattened.request_parameters like "*\"Action\":\"*\"*" or aws.cloudtrail.flattened.request_parameters like "*\"Resource\":\"*\"*" or aws.cloudtrail.flattened.request_parameters like "*AdministratorAccess*")
