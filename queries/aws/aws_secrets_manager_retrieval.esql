from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="secretsmanager.amazonaws.com" and (aws.cloudtrail.event_name in ("GetSecretValue", "BatchGetSecretValue")) or aws.cloudtrail.event_source=="ssm.amazonaws.com" and (aws.cloudtrail.event_name in ("GetParameter", "GetParameters", "GetParametersByPath"))
