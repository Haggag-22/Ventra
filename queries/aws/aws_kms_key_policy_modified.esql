from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="kms.amazonaws.com" and aws.cloudtrail.event_name=="PutKeyPolicy" and (aws.cloudtrail.flattened.request_parameters like "*\"Principal\":\"*\"*" or aws.cloudtrail.flattened.request_parameters like "*\"Principal\":{\"AWS\":\"*\"}*" or aws.cloudtrail.flattened.request_parameters like "*:root\"*" or aws.cloudtrail.flattened.request_parameters like "*\"kms:*\"*" or aws.cloudtrail.flattened.request_parameters like "*\"kms:Decrypt\"*")
