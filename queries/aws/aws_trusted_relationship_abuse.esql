from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="sts.amazonaws.com" and (aws.cloudtrail.event_name in ("AssumeRole", "AssumeRoleWithSAML", "AssumeRoleWithWebIdentity")) or aws.cloudtrail.event_source=="iam.amazonaws.com" and (aws.cloudtrail.event_name in ("CreateUser", "AttachRolePolicy", "CreateAccessKey", "UpdateAssumeRolePolicy", "CreateLoginProfile"))
