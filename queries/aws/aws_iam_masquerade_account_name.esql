from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="iam.amazonaws.com" and aws.cloudtrail.event_name=="CreateUser" and (aws.cloudtrail.flattened.request_parameters like "*userName\":\"aws-*" or aws.cloudtrail.flattened.request_parameters like "*userName\":\"AWS-*" or aws.cloudtrail.flattened.request_parameters like "*userName\":\"admin*" or aws.cloudtrail.flattened.request_parameters like "*userName\":\"root*" or aws.cloudtrail.flattened.request_parameters like "*userName\":\"support*" or aws.cloudtrail.flattened.request_parameters like "*userName\":\"service*" or aws.cloudtrail.flattened.request_parameters like "*userName\":\"billing*" or aws.cloudtrail.flattened.request_parameters like "*userName\":\"security*" or aws.cloudtrail.flattened.request_parameters like "*userName\":\"cloudtrail*")
