from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="lambda.amazonaws.com" and (aws.cloudtrail.event_name in ("CreateEventSourceMapping", "PutFunctionEventInvokeConfig")) or aws.cloudtrail.event_source=="events.amazonaws.com" and (aws.cloudtrail.event_name in ("PutRule", "PutTargets")) or aws.cloudtrail.event_source=="s3.amazonaws.com" and aws.cloudtrail.event_name=="PutBucketNotification"
