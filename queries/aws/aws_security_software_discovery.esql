from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="guardduty.amazonaws.com" and (aws.cloudtrail.event_name in ("ListDetectors", "GetDetector")) or aws.cloudtrail.event_source=="config.amazonaws.com" and (aws.cloudtrail.event_name in ("DescribeConfigRules", "DescribeConfigurationRecorders")) or aws.cloudtrail.event_source=="securityhub.amazonaws.com" and (aws.cloudtrail.event_name in ("GetFindings", "DescribeHub", "GetEnabledStandards")) or aws.cloudtrail.event_source=="wafv2.amazonaws.com" and aws.cloudtrail.event_name=="ListWebACLs"
