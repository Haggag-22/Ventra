from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="iam.amazonaws.com" and aws.cloudtrail.event_name=="PutUserPolicy" and user_agent.original like "*S3 Browser*" and aws.cloudtrail.flattened.request_parameters like "*\"arn:aws:s3:::<YOUR-BUCKET-NAME>/*\"*" and aws.cloudtrail.flattened.request_parameters like "*\"s3:GetObject\"*" and aws.cloudtrail.flattened.request_parameters like "*\"Allow\"*"
