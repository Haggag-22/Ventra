from * metadata _id, _index, _version | where aws.cloudtrail.event_source=="iam.amazonaws.com" and (aws.cloudtrail.event_name in ("PutRolePolicy", "PutUserPolicy")) and aws.cloudtrail.flattened.request_parameters like "*policyDocument*" and aws.cloudtrail.flattened.request_parameters like "*Effect*" and aws.cloudtrail.flattened.request_parameters like "*Allow*" and aws.cloudtrail.flattened.request_parameters like "*Action*" and aws.cloudtrail.flattened.request_parameters like "*Resource*"
