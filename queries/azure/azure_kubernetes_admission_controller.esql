from * metadata _id, _index, _version | where (starts_with(azure.activitylogs.operation_name, "MICROSOFT.KUBERNETES/CONNECTEDCLUSTERS/ADMISSIONREGISTRATION.K8S.IO") or starts_with(azure.activitylogs.operation_name, "MICROSOFT.CONTAINERSERVICE/MANAGEDCLUSTERS/ADMISSIONREGISTRATION.K8S.IO")) and (ends_with(azure.activitylogs.operation_name, "/MUTATINGWEBHOOKCONFIGURATIONS/WRITE") or ends_with(azure.activitylogs.operation_name, "/VALIDATINGWEBHOOKCONFIGURATIONS/WRITE"))
