from * metadata _id, _index, _version | where azure.activitylogs.operation_name in ("MICROSOFT.KEYVAULT/VAULTS/KEYS/UPDATE/ACTION", "MICROSOFT.KEYVAULT/VAULTS/KEYS/CREATE", "MICROSOFT.KEYVAULT/VAULTS/KEYS/CREATE/ACTION", "MICROSOFT.KEYVAULT/VAULTS/KEYS/IMPORT/ACTION", "MICROSOFT.KEYVAULT/VAULTS/KEYS/RECOVER/ACTION", "MICROSOFT.KEYVAULT/VAULTS/KEYS/RESTORE/ACTION", "MICROSOFT.KEYVAULT/VAULTS/KEYS/DELETE", "MICROSOFT.KEYVAULT/VAULTS/KEYS/BACKUP/ACTION", "MICROSOFT.KEYVAULT/VAULTS/KEYS/PURGE/ACTION")
