from * metadata _id, _index, _version | where azure.auditlogs.properties.category=="RoleManagement" and azure.auditlogs.operation_name like "*Add*" and azure.auditlogs.operation_name like "*member to role*" and (azure.auditlogs.flattened.target_resources like "*7698a772-787b-4ac8-901f-60d6b08affd2*" or azure.auditlogs.flattened.target_resources like "*62e90394-69f5-4237-9190-012177145e10*")
