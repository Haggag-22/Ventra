from * metadata _id, _index, _version | where azure.auditlogs.properties.logged_by_service=="Core Directory" and azure.auditlogs.properties.category=="UserManagement" and azure.auditlogs.operation_name=="Update user" and azure.auditlogs.properties.target_resources.modified_properties.display_name=="StrongAuthenticationRequirement" and azure.auditlogs.properties.target_resources.modified_properties.new_value like "*State\":0*"
