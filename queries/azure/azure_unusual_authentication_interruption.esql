from * metadata _id, _index, _version | where azure.signinlogs.result_type=="50097" and azure.signinlogs.result_description=="Device authentication is required" or azure.signinlogs.result_type=="50155" and azure.signinlogs.result_description=="DeviceAuthenticationFailed" or azure.signinlogs.result_type=="50158" and azure.signinlogs.result_description=="ExternalSecurityChallenge - External security challenge was not satisfied"
