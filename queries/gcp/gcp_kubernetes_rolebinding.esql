from * metadata _id, _index, _version | where gcp.audit.method_name like "io.k8s.authorization.rbac.v*.clusterrolebindings.create" or gcp.audit.method_name like "io.k8s.authorization.rbac.v*.rolebindings.create" or gcp.audit.method_name like "io.k8s.authorization.rbac.v*.clusterrolebindings.patch" or gcp.audit.method_name like "io.k8s.authorization.rbac.v*.rolebindings.patch" or gcp.audit.method_name like "io.k8s.authorization.rbac.v*.clusterrolebindings.update" or gcp.audit.method_name like "io.k8s.authorization.rbac.v*.rolebindings.update" or gcp.audit.method_name like "io.k8s.authorization.rbac.v*.clusterrolebindings.delete" or gcp.audit.method_name like "io.k8s.authorization.rbac.v*.rolebindings.delete"
