from gcp-* metadata _id, _index, _version | where gcp.resource.type=="k8s_cluster" and (gcp.log_name like "*cloudaudit.googleapis.com/activity*" or gcp.log_name like "*cloudaudit.googleapis.com%2Factivity*") and gcp.audit.method_name=="io.k8s.core.v1.pods.create" and (gcp.text_payload like "*image-policy.k8s.io/break-glass*" or gcp.log_message like "*image-policy.k8s.io/break-glass*" or message like "*image-policy.k8s.io/break-glass*")
