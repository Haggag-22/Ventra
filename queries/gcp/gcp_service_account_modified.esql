from * metadata _id, _index, _version | where ends_with(gcp.audit.method_name, ".serviceAccounts.patch") or ends_with(gcp.audit.method_name, ".serviceAccounts.create") or ends_with(gcp.audit.method_name, ".serviceAccounts.update") or ends_with(gcp.audit.method_name, ".serviceAccounts.enable") or ends_with(gcp.audit.method_name, ".serviceAccounts.undelete")
