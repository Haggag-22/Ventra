from * metadata _id, _index, _version | where gcp.audit.method_name like "v*.Compute.PacketMirrorings.Get" or gcp.audit.method_name like "v*.Compute.PacketMirrorings.Delete" or gcp.audit.method_name like "v*.Compute.PacketMirrorings.Insert" or gcp.audit.method_name like "v*.Compute.PacketMirrorings.Patch" or gcp.audit.method_name like "v*.Compute.PacketMirrorings.List" or gcp.audit.method_name like "v*.Compute.PacketMirrorings.aggregatedList"
