from gcp-* metadata _id, _index, _version | where gcp.audit.authorization_permission in ("accesscontextmanager.accessPolicies.delete", "accesscontextmanager.accessPolicies.accessLevels.delete", "accesscontextmanager.accessPolicies.accessZones.delete", "accesscontextmanager.accessPolicies.authorizedOrgsDescs.delete") and gcp.audit.service_name=="accesscontextmanager.googleapis.com"
