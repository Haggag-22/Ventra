{
    "PolicyVersion": {
        "Document": {
            "Version": "2012-10-17",
            "Statement": [
                {
                    "Sid": "DenyProductionRegions",
                    "Effect": "Deny",
                    "Action": "*",
                    "Resource": "*",
                    "Condition": {
                        "StringEquals": {
                            "aws:RequestedRegion": [
                                "us-west-2",
                                "eu-west-2"
                            ]
                        }
                    }
                },
                {
                    "Sid": "CloudTrailEvidence",
                    "Effect": "Allow",
                    "Action": [
                        "cloudtrail:LookupEvents"
                    ],
                    "Resource": "*"
                },
                {
                    "Sid": "CloudWatchEvidence",
                    "Effect": "Allow",
                    "Action": [
                        "logs:DescribeLogGroups",
                        "logs:FilterLogEvents"
                    ],
                    "Resource": "*"
                },
                {
                    "Sid": "S3LogEvidence",
                    "Effect": "Allow",
                    "Action": [
                        "s3:ListBucket",
                        "s3:GetObject"
                    ],
                    "Resource": "arn:aws:s3:::xfir-aws-logs/*"
                },
                {
                    "Sid": "WAFEvidence",
                    "Effect": "Allow",
                    "Action": [
                        "wafv2:GetSampledRequests"
                    ],
                    "Resource": "*"
                }
            ]
        },
        "VersionId": "v3",
        "IsDefaultVersion": true,
        "CreateDate": "2026-07-20T22:24:42+00:00"
    }
}
