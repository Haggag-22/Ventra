resource "aws_s3_bucket" "sensitive" {
  bucket = "${var.project}-sensitive-data-${local.bucket_suffix}"
  tags   = { Purpose = "sensitive-data", Collector = "s3", DataClass = "pii" }
}

resource "aws_s3_bucket_logging" "sensitive" {
  bucket        = aws_s3_bucket.sensitive.id
  target_bucket = aws_s3_bucket.access_logs.id
  target_prefix = "sensitive-data/"
}

resource "aws_s3_bucket_public_access_block" "sensitive" {
  bucket                  = aws_s3_bucket.sensitive.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_object" "db_dump_marker" {
  bucket  = aws_s3_bucket.sensitive.id
  key     = "exports/db-dump-2026-06-07.sql.gz"
  content = "-- synthetic db export marker for ventra lab\n"
  tags    = { Story = "exfiltration-target" }
}

