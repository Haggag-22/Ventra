{
  "title": "Ventra Kubernetes Collector \u2014 Read-Only RBAC",
  "description": "Minimum API permissions for Ventra Kubernetes collectors. Apply as a ClusterRole (see kubernetes-collector-readonly.yaml) \u2014 not cloud IAM. Secret values are never read; get/list/watch on secrets is metadata only.",
  "permissions": [
    "create selfsubjectaccessreviews",
    "get /apis",
    "get /version",
    "get events",
    "get pods",
    "get pods/log",
    "list clusterrolebindings",
    "list clusterroles",
    "list configmaps",
    "list cronjobs",
    "list customresourcedefinitions",
    "list daemonsets",
    "list deployments",
    "list events",
    "list events.k8s.io events",
    "list ingresses",
    "list jobs",
    "list mutatingwebhookconfigurations",
    "list namespaces",
    "list networkpolicies",
    "list nodes",
    "list persistentvolumeclaims",
    "list persistentvolumes",
    "list pods",
    "list replicasets",
    "list rolebindings",
    "list roles",
    "list secrets",
    "list serviceaccounts",
    "list services",
    "list statefulsets",
    "list validatingwebhookconfigurations",
    "watch events"
  ]
}
